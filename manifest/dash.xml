<?xml version='1.0' encoding='UTF-8'?>
<manifest>
  <remote name='ossgh' fetch='https://github.com/' />
  <remote name='ossgl' fetch='https://gitlab.com/' />
  <!-- Fork di alesx2io: upstream oss-dash / oss-dash-kernel con i fix per dash.
       Infinity-X (frameworks/base, build/soong) resta upstream, i fix sono patch. -->
  <remote name='dash' fetch='https://github.com/alesx2io/' />
  <remote name='dashgl' fetch='https://gitlab.com/alesx2io/' />

  <!-- Evita path duplicati con repo Lineage eventualmente già presenti in Infinity -->
  <remove-project name='LineageOS/android_hardware_xiaomi' optional='true' />
  <remove-project name='LineageOS/android_hardware_mediatek' optional='true' />
  <remove-project name='LineageOS/android_device_mediatek_sepolicy_vndr' optional='true' />

  <!-- Device tree, camera e kernel prebuilt (ramo infinity = variante prebuilt, infinity-kleaf = Kleaf) -->
  <project path='device/xiaomi/dash' name='android_device_xiaomi_dash' remote='dash' revision='infinity' />
  <project path='device/xiaomi/dash-miuicamera' name='android_device_xiaomi_dash-miuicamera' remote='dash' revision='lineage-24.0' />
  <project path='device/xiaomi/dash-kernel' name='android_device_xiaomi_dash-kernel' remote='dash' revision='lineage-24.0' />

  <!-- Blob vendor (GitLab) -->
  <project path='vendor/xiaomi/dash' name='proprietary_vendor_xiaomi_dash' remote='dashgl' revision='infinity' />
  <project path='vendor/xiaomi/dash-miuicamera' name='proprietary_vendor_xiaomi_dash-miuicamera' remote='dashgl' revision='lineage-24.0' />

  <!-- Hardware e sepolicy -->
  <project path='hardware/mediatek' name='android_hardware_mediatek' remote='dash' revision='lineage-24.0' />
  <project path='hardware/xiaomi' name='android_hardware_xiaomi' remote='dash' revision='lineage-24.0' />
  <project path='device/mediatek/sepolicy_vndr' name='android_device_mediatek_sepolicy_vndr' remote='dash' revision='lineage-24.0' />

  <!-- Dolby -->
  <project path='packages/apps/LunarisDolby' name='android_packages_apps_LunarisDolby' remote='dash' revision='lineage-24.0' />

  <!-- Patch che sostituiscono i repo originali -->
  <remove-project name='LineageOS/android_vendor_qcom_opensource_vibrator' optional='true' />
  <project path='vendor/qcom/opensource/vibrator' name='android_vendor_qcom_opensource_vibrator' remote='dash' revision='lineage-24.0' />
  <!-- Kernel da sorgenti (variante Kleaf, device tree branch infinity-kleaf).
       Infinity esclude kernel/platform dalla scansione Soong, quindi non tocca la variante prebuilt. -->
  <project path="kernel/platform/kernel-6.6/kernel-6.6" name="android_kernel" remote="dash" revision="lineage-24.0" groups="kernel-platform,kernel-platform-66" />
  <project path="kernel/platform/kernel-6.6/kernel_device_modules-6.6" name="android_kernel_device_modules" remote="dash" revision="lineage-24.0" groups="kernel-platform,kernel-platform-66">
    <linkfile src="kernel/kleaf/device.bazelrc" dest="kernel/platform/kernel-6.6/device.bazelrc" />
    <linkfile src="kernel/kleaf/build.sh" dest="kernel/platform/kernel-6.6/build.sh" />
  </project>
  <project path="kernel/platform/kernel-6.6/vendor/mediatek/kernel_modules" name="android_kernel_vendor_mediatek_kernel_modules" remote="dash" revision="lineage-24.0" groups="kernel-platform,kernel-platform-66" />
  <project path="kernel/platform/kernel-6.6/build/bazel_mgk_rules" name="android_kernel_build_bazel_mgk_rules" remote="dash" revision="lineage-24.0" groups="kernel-platform,kernel-platform-66">
    <linkfile src="kleaf/bazel.WORKSPACE" dest="kernel/platform/kernel-6.6/WORKSPACE" />
    <linkfile src="kleaf/bazel.sh" dest="kernel/platform/kernel-6.6/tools/bazel" />
  </project>

