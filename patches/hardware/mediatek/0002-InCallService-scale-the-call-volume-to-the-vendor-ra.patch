From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: alesx2io <96351978+alesx2io@users.noreply.github.com>
Date: Thu, 19 Nov 2026 15:54:43 +0100
Subject: [PATCH] InCallService: scale the call volume to the vendor range

The framework can use more STREAM_VOICE_CALL steps than the vendor
(ro.config.vc_call_vol_steps): AudioService raises the call range to the
Bluetooth SCO one, 15 steps on dash. The index was clamped to the vendor
maximum, so the whole upper half of the slider sent the highest gain.

Scale the index linearly to 1..vc_call_vol_steps instead.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../incallservice/CallStateListener.java       |  3 ++-
 .../mediatek/incallservice/GainUtils.java      | 18 ++++++++++++++++++
 .../incallservice/VolumeChangeReceiver.java    |  3 ++-
 3 files changed, 22 insertions(+), 2 deletions(-)

diff --git a/packages/InCallService/src/org/lineageos/mediatek/incallservice/CallStateListener.java b/packages/InCallService/src/org/lineageos/mediatek/incallservice/CallStateListener.java
index 5c42a91..b64570c 100644
--- a/packages/InCallService/src/org/lineageos/mediatek/incallservice/CallStateListener.java
+++ b/packages/InCallService/src/org/lineageos/mediatek/incallservice/CallStateListener.java
@@ -25,7 +25,8 @@ public class CallStateListener extends TelephonyCallback implements TelephonyCal
     public void onCallStateChanged(int state) {
         if (state == TelephonyManager.CALL_STATE_OFFHOOK || state == TelephonyManager.CALL_STATE_RINGING) {
             Log.d(LOG_TAG, "CallStateListener: CALL_STATE_OFFHOOK, setting gain.");
-            GainUtils.setGainLevel(mAudioManager.getStreamVolume(AudioManager.STREAM_VOICE_CALL));
+            GainUtils.setGainLevel(GainUtils.toVendorIndex(mAudioManager,
+                    mAudioManager.getStreamVolume(AudioManager.STREAM_VOICE_CALL)));
         }
     }
 }
diff --git a/packages/InCallService/src/org/lineageos/mediatek/incallservice/GainUtils.java b/packages/InCallService/src/org/lineageos/mediatek/incallservice/GainUtils.java
index 2cafcaa..e7dedfc 100644
--- a/packages/InCallService/src/org/lineageos/mediatek/incallservice/GainUtils.java
+++ b/packages/InCallService/src/org/lineageos/mediatek/incallservice/GainUtils.java
@@ -8,6 +8,7 @@ package org.lineageos.mediatek.incallservice;
 
 import android.media.AudioSystem;
 import android.media.AudioDeviceInfo;
+import android.media.AudioManager;
 import android.os.SystemProperties;
 import android.util.Log;
 
@@ -15,6 +16,23 @@ public class GainUtils {
     public static final String LOG_TAG = "MtkInCallService";
     public static final int volSteps = SystemProperties.getInt("ro.config.vc_call_vol_steps", 7);
 
+    /**
+     * Maps a STREAM_VOICE_CALL index to the vendor range 1..volSteps.
+     * The framework can use more call volume steps than the vendor (for example it raises
+     * the call range to the Bluetooth SCO one), so clamping would turn the whole upper part
+     * of the slider into the maximum gain.
+     * @param audioManager Used to read the call stream range.
+     * @param index The STREAM_VOICE_CALL index.
+     * @return The index scaled to the vendor range.
+     */
+    public static int toVendorIndex(AudioManager audioManager, int index) {
+        int maxIndex = audioManager.getStreamMaxVolume(AudioManager.STREAM_VOICE_CALL);
+        if (maxIndex <= volSteps || index <= 1) {
+            return index;
+        }
+        return 1 + Math.round((index - 1) * (volSteps - 1) / (float) (maxIndex - 1));
+    }
+
     /**
      * Sets the gain level for a given audio device.
      * @param audioDevice The audio device to set the gain level for.
diff --git a/packages/InCallService/src/org/lineageos/mediatek/incallservice/VolumeChangeReceiver.java b/packages/InCallService/src/org/lineageos/mediatek/incallservice/VolumeChangeReceiver.java
index a3353c9..7a9cadb 100644
--- a/packages/InCallService/src/org/lineageos/mediatek/incallservice/VolumeChangeReceiver.java
+++ b/packages/InCallService/src/org/lineageos/mediatek/incallservice/VolumeChangeReceiver.java
@@ -33,7 +33,8 @@ public class VolumeChangeReceiver extends BroadcastReceiver {
             if (volumeIndex == -1)
                 volumeIndex = mAudioManager.getStreamVolume(AudioManager.STREAM_VOICE_CALL);
 
-            GainUtils.setGainLevel(callDevice.getPort().type(), volumeIndex, AudioSystem.STREAM_VOICE_CALL);
+            GainUtils.setGainLevel(callDevice.getPort().type(),
+                    GainUtils.toVendorIndex(mAudioManager, volumeIndex), AudioSystem.STREAM_VOICE_CALL);
         }
     }
 
-- 
