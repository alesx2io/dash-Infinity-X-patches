From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: alesx2io <96351978+alesx2io@users.noreply.github.com>
Date: Tue, 17 Nov 2026 18:07:59 +0100
Subject: [PATCH] SystemUI: fade in notification pulses more smoothly

When the screen wakes for a notification, the front scrim fades from
black to the lock screen in 220ms, which reads as a dark frame followed
by a jump in brightness. Use a 600ms decelerating fade instead (the
long 1000ms one is still used for the wake lock screen sensor).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../android/systemui/statusbar/phone/ScrimController.java  | 7 +++++++
 .../com/android/systemui/statusbar/phone/ScrimState.java   | 2 +-
 2 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/packages/SystemUI/src/com/android/systemui/statusbar/phone/ScrimController.java b/packages/SystemUI/src/com/android/systemui/statusbar/phone/ScrimController.java
index 939d52403..bf114bf98 100644
--- a/packages/SystemUI/src/com/android/systemui/statusbar/phone/ScrimController.java
+++ b/packages/SystemUI/src/com/android/systemui/statusbar/phone/ScrimController.java
@@ -132,6 +132,13 @@ public class ScrimController implements ViewTreeObserver.OnPreDrawListener, Dump
      * Longer duration, currently only used when going to AOD.
      */
     public static final long ANIMATION_DURATION_LONG = 1000;
+
+    /**
+     * Fade-in used when the screen wakes up for a notification pulse. The default 220ms fade from
+     * black reads as a jump in brightness; a longer decelerating fade looks like the screen
+     * gently lighting up.
+     */
+    public static final long ANIMATION_DURATION_PULSE = 600;
     /**
      * When both scrims have 0 alpha.
      */
diff --git a/packages/SystemUI/src/com/android/systemui/statusbar/phone/ScrimState.java b/packages/SystemUI/src/com/android/systemui/statusbar/phone/ScrimState.java
index caaef9a75..8a2610d4c 100644
--- a/packages/SystemUI/src/com/android/systemui/statusbar/phone/ScrimState.java
+++ b/packages/SystemUI/src/com/android/systemui/statusbar/phone/ScrimState.java
@@ -302,7 +302,7 @@ public enum ScrimState {
             mFrontTint = mBackgroundColor;
             mBlankScreen = mDisplayRequiresBlanking;
             mAnimationDuration = mWakeLockScreenSensorActive
-                    ? ScrimController.ANIMATION_DURATION_LONG : ScrimController.ANIMATION_DURATION;
+                    ? ScrimController.ANIMATION_DURATION_LONG : ScrimController.ANIMATION_DURATION_PULSE;
         }
     },
 
