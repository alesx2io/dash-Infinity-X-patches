From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: alesx2io <96351978+alesx2io@users.noreply.github.com>
Date: Mon, 16 Nov 2026 19:31:42 +0100
Subject: [PATCH] pm: pin Settings Services to its preinstalled version

Settings Services builds newer than the bundled 1.1.0.884201616 only
index Pixel Settings; after the Play Store update Settings search
returns almost nothing (0 indexed entries vs 1952 with the bundled one).

Add config_pinnedSystemPackages: updates to listed system packages are
rejected unless they come from adb or root.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 core/res/res/values/infinity_config.xml       |  8 ++++++++
 core/res/res/values/infinity_symbols.xml      |  3 +++
 .../server/pm/InstallPackageHelper.java       | 20 +++++++++++++++++++
 3 files changed, 31 insertions(+)

diff --git a/core/res/res/values/infinity_config.xml b/core/res/res/values/infinity_config.xml
index 7d1a7e5e1..eb6cd14c2 100644
--- a/core/res/res/values/infinity_config.xml
+++ b/core/res/res/values/infinity_config.xml
@@ -119,4 +119,12 @@
         <item>com.qualcomm.qti.cne</item>
         <item>com.shannon.imsservice</item>
     </string-array>
+
+    <!-- System packages that must stay at their preinstalled version. Updates coming from
+         app stores are rejected; adb/root installs are still allowed.
+         Settings Services newer than the bundled build only index Pixel Settings, which
+         leaves Settings search empty on this ROM. -->
+    <string-array name="config_pinnedSystemPackages" translatable="false">
+        <item>com.google.android.settings.intelligence</item>
+    </string-array>
 </resources>
diff --git a/core/res/res/values/infinity_symbols.xml b/core/res/res/values/infinity_symbols.xml
index 6539f1194..a98c46eb6 100644
--- a/core/res/res/values/infinity_symbols.xml
+++ b/core/res/res/values/infinity_symbols.xml
@@ -106,4 +106,7 @@
 
     <!-- These are system packages exempted from privacy indicator -->
     <java-symbol type="array" name="config_indicatorExemptedPackageNames" />
+
+    <!-- System packages pinned to their preinstalled version -->
+    <java-symbol type="array" name="config_pinnedSystemPackages" />
 </resources>
diff --git a/services/core/java/com/android/server/pm/InstallPackageHelper.java b/services/core/java/com/android/server/pm/InstallPackageHelper.java
index 7e3eae0f6..9555d22f5 100644
--- a/services/core/java/com/android/server/pm/InstallPackageHelper.java
+++ b/services/core/java/com/android/server/pm/InstallPackageHelper.java
@@ -1675,6 +1675,26 @@ final class InstallPackageHelper {
             Trace.traceEnd(TRACE_TAG_PACKAGE_MANAGER);
         }
 
+        // Keep pinned system packages at their preinstalled version: reject updates unless
+        // they come from adb or root.
+        if (!isApex) {
+            final int installerUid = request.getInstallerPackageUid();
+            final String[] pinnedPackages = mContext.getResources().getStringArray(
+                    com.android.internal.R.array.config_pinnedSystemPackages);
+            if (installerUid != Process.ROOT_UID && installerUid != Process.SHELL_UID
+                    && ArrayUtils.contains(pinnedPackages, parsedPackage.getPackageName())) {
+                final PackageStateInternal pinnedState = mPm.snapshotComputer()
+                        .getPackageStateInternal(parsedPackage.getPackageName());
+                if (pinnedState != null && pinnedState.isSystem()) {
+                    Slog.w(TAG, "Rejecting update of pinned system package "
+                            + parsedPackage.getPackageName());
+                    throw new PrepareFailure(PackageManager.INSTALL_FAILED_ABORTED,
+                            "Package " + parsedPackage.getPackageName()
+                                    + " is pinned to its preinstalled version");
+                }
+            }
+        }
+
         // Block the install of apps using a lower target SDK version than required.
         // This helps improve security and privacy as malware can target older SDK versions
         // to avoid enforcement of new API behavior.
