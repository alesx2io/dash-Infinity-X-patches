From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: alesx2io <alesx2io@users.noreply.github.com>
Date: Mon, 16 Nov 2026 18:56:55 +0100
Subject: [PATCH] dash: use 30 media volume steps

The vendor audio config declares 30 media steps
(ro.vendor.audio.media.volume.steps) and a default of 20, but the
framework was left at the AOSP 15, so the default was clamped to max and
the lowest step was louder than on stock.

Scale the safe headphone volume index accordingly (10/15 -> 20/30).

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 overlay/DashFrameworksOverlay/res/values/config.xml | 4 ++++
 vendor.prop                                         | 1 +
 2 files changed, 5 insertions(+)

diff --git a/overlay/DashFrameworksOverlay/res/values/config.xml b/overlay/DashFrameworksOverlay/res/values/config.xml
index 5009a81..ccce584 100644
--- a/overlay/DashFrameworksOverlay/res/values/config.xml
+++ b/overlay/DashFrameworksOverlay/res/values/config.xml
@@ -764,4 +764,8 @@
 
     <!-- Whether to enable fp unlock when screen turns off on udfps devices -->
     <bool name="config_screen_off_udfps_enabled">true</bool>
+    <!-- Safe headphone volume index. Media uses 30 steps (ro.config.media_vol_steps),
+         so keep the AOSP ratio of 10/15. -->
+    <integer name="config_safe_media_volume_index">20</integer>
+
 </resources>
diff --git a/vendor.prop b/vendor.prop
index 5461379..6cdd022 100644
--- a/vendor.prop
+++ b/vendor.prop
@@ -20,6 +20,7 @@ persist.vendor.speech.usb.offload=true
 ro.audio.monitorRotation=true
 ro.audio.spatializer_enabled=true
 ro.config.media_vol_default=20
+ro.config.media_vol_steps=30
 ro.config.vc_call_vol_default=6
 ro.config.vc_call_vol_steps=7
 ro.vendor.audio.camera_gain=true
